{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly visible contributor profile with zero private PII or personal location history.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[a-z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512
        },
        "homeNeighborhood": {
          "type": "string",
          "maxLength": 64
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "distinctPotholeCount": {
          "type": "integer"
        },
        "evidenceCount": {
          "type": "integer"
        },
        "unlockedBadgesCount": {
          "type": "integer"
        },
        "potholesCollectedCount": {
          "type": "integer",
          "description": "Server-maintained count of classifier- or admin-approved pothole photos, including accepted evidence."
        },
        "dailyStreak": {
          "type": "integer",
          "description": "Consecutive UTC days with at least one approved pothole capture."
        },
        "lastCollectedDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "showOnLeaderboard": {
          "type": "boolean"
        },
        "shareNeighborhood": {
          "type": "boolean"
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "joinedAt",
        "updatedAt",
        "distinctPotholeCount",
        "evidenceCount",
        "unlockedBadgesCount",
        "potholesCollectedCount",
        "dailyStreak",
        "showOnLeaderboard",
        "shareNeighborhood"
      ]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Strictly private account metadata isolated from public profiles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
