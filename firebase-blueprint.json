        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "notificationsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "MediaObject": {
      "title": "MediaObject",
      "description": "Isolated compressed image binary (Firestore Bytes <= 400KB) kept separate from pothole, submission, and user documents.",
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "contentType": {
          "type": "string",
          "enum": [
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        },
        "sizeBytes": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "data": {
          "type": "string",
          "format": "byte"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "mediaId",
        "ownerId",
        "contentType",
        "sizeBytes",
        "width",
        "height",
        "data",
        "createdAt"
      ]
    },
    "StorageVerificationRecord": {
      "title": "StorageVerificationRecord",
