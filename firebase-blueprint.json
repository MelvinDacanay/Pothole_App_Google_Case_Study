    "PotholeRecord": {
      "title": "PotholeRecord",
      "description": "Canonical distinct pothole record created and updated strictly by trusted server-side transactions.",
      "type": "object",
      "properties": {
        "potholeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
