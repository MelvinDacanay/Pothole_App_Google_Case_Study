            "gps_verified",
            "exif_extracted",
            "manual_pin"
          ]
        },
        "accuracyMeters": {
          "type": "number"
        },
        "formattedAddress": {
          "type": "string",
          "maxLength": 256
        },
        "streetName": {
          "type": "string",
          "maxLength": 128
        },
        "normalizedStreet": {
          "type": "string",
          "maxLength": 128
        },
        "neighborhood": {
          "type": "string",
          "maxLength": 128
        },
        "city": {
          "type": "string",
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "maxLength": 32
        },
        "postalCode": {
          "type": "string",
          "maxLength": 20
        },
        "placeId": {
          "type": "string",
          "maxLength": 128
        },
        "jurisdiction": {
          "type": "string",
          "enum": [
            "atldot",
            "gdot",
            "unknown"
          ]
        },
        "segmentId": {
          "type": "string",
          "maxLength": 128
        },
        "segmentConfidence": {
          "type": "string",
          "enum": [
            "verified",
            "provisional",
            "needs_review"
          ]
        },
        "locationUserCorrected": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "provisional",
            "reported",
            "acknowledged",
            "repaired",
            "rejected"
          ]
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "accepted",
            "provisional",
            "needs_review",
            "rejected"
          ]
        },
        "severityLabel": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "severe",
            "unclassified"
          ]
        },
        "primaryContributorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "primaryContributorUsername": {
          "type": "string",
          "maxLength": 32
        },
        "primaryContributorDisplayName": {
          "type": "string",
          "maxLength": 64
        },
        "primaryContributorPhotoURL": {
          "type": "string",
          "maxLength": 512,
          "description": "Public-safe profile image snapshot used in community gallery attribution."
        },
        "primaryPhotoUrl": {
          "type": "string",
          "maxLength": 512
        },
        "primaryMediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "evidenceCount": {
          "type": "integer"
        },
        "submissionCount": {
          "type": "integer"
        },
        "aiReviewSummary": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
