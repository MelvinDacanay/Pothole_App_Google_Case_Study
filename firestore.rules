rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Privileged reads and writes are server-only. Rules cannot consult the
    // runtime email allowlist, so neither a claim nor an admins document grants access.

    // Validation Blueprints
    function isValidUserPublicProfile(data, uid) {
      return data.keys().hasAll([
        'uid', 'username', 'displayName', 'joinedAt', 'updatedAt',
        'distinctPotholeCount', 'evidenceCount', 'unlockedBadgesCount',
        'showOnLeaderboard', 'shareNeighborhood'
      ])
      && data.keys().hasOnly([
        'uid', 'username', 'displayName', 'photoURL', 'bio', 'homeNeighborhood', 'joinedAt', 'updatedAt',
        'distinctPotholeCount', 'evidenceCount', 'unlockedBadgesCount',
        'potholesCollectedCount', 'dailyStreak', 'lastCollectedDate',
        'showOnLeaderboard', 'shareNeighborhood'
      ])
      && data.uid == uid
      && isValidId(data.uid)
      && data.username is string && data.username.size() >= 3 && data.username.size() <= 32 && data.username.matches('^[a-z0-9_]+$')
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
      && (!('bio' in data) || (data.bio is string && data.bio.size() <= 160))
      && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
      && (!('homeNeighborhood' in data) || (data.homeNeighborhood is string && data.homeNeighborhood.size() <= 64))
      && data.joinedAt is timestamp
      && data.updatedAt is timestamp
      && data.distinctPotholeCount is int && data.distinctPotholeCount >= 0
      && data.evidenceCount is int && data.evidenceCount >= 0
      && data.unlockedBadgesCount is int && data.unlockedBadgesCount >= 0
      && (!('potholesCollectedCount' in data) || (data.potholesCollectedCount is int && data.potholesCollectedCount >= 0))
      && (!('dailyStreak' in data) || (data.dailyStreak is int && data.dailyStreak >= 0))
      && (!('lastCollectedDate' in data) || (data.lastCollectedDate is string && data.lastCollectedDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
      && data.showOnLeaderboard is bool
      && data.shareNeighborhood is bool;
    }

    function isValidUserPrivateAccount(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'notificationsEnabled', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.notificationsEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMediaObject(data, mediaId) {
      return data.keys().hasAll([
        'mediaId', 'ownerId', 'contentType', 'sizeBytes', 'width', 'height', 'data', 'createdAt'
      ])
      && data.keys().hasOnly([
        'mediaId', 'ownerId', 'contentType', 'sizeBytes', 'width', 'height', 'data', 'createdAt'
      ])
      && data.mediaId == mediaId
      && isValidId(data.mediaId)
      && isValidId(data.ownerId)
      && data.ownerId == request.auth.uid
      && data.contentType in ['image/jpeg', 'image/png', 'image/webp']
      && data.sizeBytes is int && data.sizeBytes > 0 && data.sizeBytes <= 400000
      && data.width is int && data.width > 0 && data.width <= 1280
      && data.height is int && data.height > 0 && data.height <= 1280
      && data.data is bytes && data.data.size() > 0 && data.data.size() <= 400000 && data.data.size() == data.sizeBytes
      && data.createdAt is timestamp;
    }

    function isValidStorageVerificationRecord(data, uid, checkId) {
      return data.keys().hasAll([
        'checkId', 'userId', 'storagePath', 'downloadUrl', 'contentType', 'sizeBytes', 'createdAt'
      ])
      && data.keys().hasOnly([
        'checkId', 'userId', 'storagePath', 'downloadUrl', 'contentType', 'sizeBytes', 'createdAt'
      ])
      && data.checkId == checkId
      && isValidId(data.checkId)
      && data.userId == uid
      && isValidId(data.userId)
      && data.storagePath is string && data.storagePath.size() >= 5 && data.storagePath.size() <= 256
      && data.storagePath.matches('^mediaObjects/[a-zA-Z0-9_\\-]+$')
      && data.downloadUrl is string && data.downloadUrl.size() >= 12 && data.downloadUrl.size() <= 1024
      && data.downloadUrl.matches('^(/api/media/|https://)[a-zA-Z0-9_\\-\\./\\?=&%]+$')
      && data.contentType in ['image/jpeg', 'image/png', 'image/webp']
      && data.sizeBytes is int && data.sizeBytes > 0 && data.sizeBytes <= 400000
      && data.createdAt is timestamp;
    }

    function isValidNotificationItem(data, uid, notificationId) {
      return data.keys().hasAll([
        'notificationId', 'uid', 'type', 'title', 'body', 'read', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasOnly([
        'notificationId', 'uid', 'type', 'title', 'body', 'relatedId', 'read', 'createdAt', 'updatedAt'
      ])
      && data.notificationId == notificationId
      && isValidId(data.notificationId)
      && data.uid == uid
      && isValidId(data.uid)
      && (
        data.type in [
          'friend_request', 'friend_accepted', 'badge_unlocked', 'leaderboard_milestone'
        ]
        || data.type in [
          'case_awaiting_ref', 'case_deadline_approaching', 'case_deadline_passed',
          'case_personal_reminder', 'case_agency_closed', 'case_repair_verified',
          'case_followup_ref_saved'
        ]
      )
      && data.title is string && data.title.size() >= 1 && data.title.size() <= 96
      && data.body is string && data.body.size() >= 1 && data.body.size() <= 240
      && (!('relatedId' in data) || (data.relatedId is string && data.relatedId.size() <= 128))
      && data.read is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Boot connection check (read-only single-doc probe)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Server-managed enrollment directory; not an authorization source
    match /admins/{uid} {
      allow read, write: if false;
    }

    // Immutable admin audit log (server-only; Admin Hub uses authenticated API)
    match /adminAudit/{eventId} {
      allow get: if false;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Server-only reverse-geocoding cache (no client access)
    match /geocodeCache/{coordKey} {
      allow read, write: if false;
    }

    // Road-aligned street segments & accepted memberships (server-written only)
    match /streetSegments/{segmentId} {
      allow get, list: if false;
      allow create, update, delete: if false;

      match /acceptedPotholes/{potholeId} {
        allow get, list: if false;
      allow create, update, delete: if false;
      }
    }

    // Consolidated 5-distinct-pothole community report cycles (server-written only)
    match /reports/{reportId} {
      allow get, list: if false;
      allow create, update, delete: if false;

      match /supplements/{supplementId} {
        allow get, list: if false;
      allow create, update, delete: if false;
      }
    }

    // Canonical distinct Atlanta pothole records (server-written via Admin SDK transactions only)
    match /potholes/{potholeId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // Individual pothole submissions & evidence links (server-written via Admin SDK transactions only)
    match /submissions/{submissionId} {
      allow get, list: if (isSignedIn() && existing().userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Friendships (server-managed via Express API; readable only by the two participants)
    match /friendships/{friendshipId} {
      allow get: if isValidId(friendshipId) && isSignedIn() && (
        request.auth.uid in existing().participantUids
      );
      allow list: if isSignedIn() && request.auth.uid in existing().participantUids;
      allow create, update, delete: if false;
    }

    // Server-maintained leaderboard statistics (clients cannot write)
    match /leaderboardStats/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (
        isOwner(uid) || existing().showOnLeaderboard == true
      );
      allow list: if isSignedIn() && existing().showOnLeaderboard == true;
      allow create, update, delete: if false;
    }

    // Server-evaluated achievements (owner read; clients cannot write)
    match /achievements/{uid}/badges/{badgeType} {
      allow get: if isValidId(uid) && isValidId(badgeType) && (isOwner(uid));
      allow list: if isValidId(uid) && isOwner(uid) && existing().uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    function isCommunityNotification() {
      return existing().type in [
          'friend_request', 'friend_accepted', 'badge_unlocked', 'leaderboard_milestone'
        ]
        || existing().type in [
          'case_awaiting_ref', 'case_deadline_approaching', 'case_deadline_passed',
          'case_personal_reminder', 'case_agency_closed', 'case_repair_verified',
          'case_followup_ref_saved'
        ];
    }

    match /potholeCases/{caseId} {
      allow read, write: if false;
    }

    // Per-user in-app notifications (owner read; owner may mark read; server creates)
    match /notifications/{uid}/items/{notificationId} {
      allow get: if isValidId(uid) && isValidId(notificationId) && isOwner(uid) && isCommunityNotification();
      allow list: if isValidId(uid) && isOwner(uid) && existing().uid == request.auth.uid && isCommunityNotification();
      allow create, delete: if false;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidId(notificationId)
        && isOwner(uid)
        && isCommunityNotification()
        && isValidNotificationItem(incoming(), uid, notificationId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().notificationId == existing().notificationId
        && incoming().type == existing().type
        && incoming().title == existing().title
        && incoming().body == existing().body
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    // Public-safe street-level and achievement activity feed (server-written only)
    match /activityFeed/{eventId} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }

    // Entertainment minigame personal bests (server-written only; isolated from community stats)
    match /gameStats/{statId} {
      allow get: if statId is string && statId.size() >= 3 && statId.size() <= 160 && statId.matches('^[a-zA-Z0-9_\\-]+$')
        && isSignedIn() && (existing().uid == request.auth.uid);
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Server-only photo evidence/thumbnail metadata and bytes; guarded API delivery
    match /mediaObjects/{mediaId} { allow read, write: if false; }
    match /redactionBudgets/{id} { allow read, write: if false; }
    match /mediaBudgets/{id} { allow read, write: if false; }
    match /roadLookups/{id} { allow read, write: if false; }
    match /geocodingBudgets/{id} { allow read, write: if false; }

    // Server-owned verification, quota, uniqueness and effect records.
    match /imageVerifications/{verificationId} { allow read, write: if false; }
    match /imageAnalysisCache/{cacheId} { allow read, write: if false; }
    match /verificationBudgets/{budgetId} { allow read, write: if false; }
    match /imageClaims/{contentHash} { allow read, write: if false; }
    match /contributionEffects/{submissionId} { allow read, write: if false; }
    match /mediaRetired/{mediaId} { allow read, write: if false; }

    // Public contributor profiles (no PII)
    match /users/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || existing().showOnLeaderboard == true);
      allow list: if isSignedIn() && existing().showOnLeaderboard == true;

      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidUserPublicProfile(incoming(), uid)
        && incoming().distinctPotholeCount == 0
        && incoming().evidenceCount == 0
        && incoming().unlockedBadgesCount == 0
        && incoming().potholesCollectedCount == 0
        && incoming().dailyStreak == 0
        && incoming().joinedAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidUserPublicProfile(incoming(), uid)
        && (
          (
            isOwner(uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'displayName', 'photoURL', 'bio', 'homeNeighborhood',
              'showOnLeaderboard', 'shareNeighborhood', 'updatedAt'
            ])
            && incoming().uid == existing().uid
            && incoming().joinedAt == existing().joinedAt
            && incoming().distinctPotholeCount == existing().distinctPotholeCount
            && incoming().evidenceCount == existing().evidenceCount
            && incoming().unlockedBadgesCount == existing().unlockedBadgesCount
            && incoming().get('potholesCollectedCount', 0) == existing().get('potholesCollectedCount', 0)
            && incoming().get('dailyStreak', 0) == existing().get('dailyStreak', 0)
            && incoming().get('lastCollectedDate', '') == existing().get('lastCollectedDate', '')
            && incoming().updatedAt == request.time
          )
        );

      allow delete: if false;

      // Server-owned account consent; only authenticated API may access it.
      match /private/consent { allow read, write: if false; }

      // Private PII subcollection (owner only)
      match /private/account {
        allow get: if isValidId(uid) && isOwner(uid);
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(uid)
          && isOwner(uid)
          && isValidUserPrivateAccount(incoming(), uid)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(uid)
          && isOwner(uid)
          && isValidUserPrivateAccount(incoming(), uid)
          && incoming().diff(existing()).affectedKeys().hasOnly(['notificationsEnabled', 'updatedAt'])
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;

        allow delete: if false;
      }

      // Legacy media reference verification metadata (zero image bytes)
      match /storageChecks/{checkId} {
        allow get: if isValidId(uid) && isValidId(checkId) && isOwner(uid);
        allow list: if isValidId(uid) && isOwner(uid) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(uid)
          && isValidId(checkId)
          && isOwner(uid)
          && isValidStorageVerificationRecord(incoming(), uid, checkId)
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}
