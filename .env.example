# Copy to .env locally; never include .env or credentials in ZIPs/Git.
VITE_FIREBASE_API_KEY=""
# Existing Firebase project, app ID and default database (default) remain in firebase-applet-config.json.
# VITE_FIRESTORE_DATABASE_ID="(default)"
# Development only. Cloud Run rejects exported credentials and emulator overrides.
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# PATCHUP_USE_ADC=true
VITE_GOOGLE_MAPS_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
# Explicitly opt into live user-image API processing only after terms/privacy/billing review.
PATCHUP_IMAGE_AI_ENABLED=false
# Never enable automatic acceptance until a held-out benchmark meets release gates.
PATCHUP_AUTO_ACCEPT=false
PATCHUP_BENCHMARK_APPROVED_VERSION=""
# Hard shared provider call budgets; 0 disables calls. Actual project quota may be lower.
PATCHUP_AI_DAILY_LIMIT=100
PATCHUP_AI_USER_DAILY_LIMIT=25
PATCHUP_AI_USER_MINUTE_LIMIT=3
PATCHUP_AI_MINUTE_LIMIT=10
# Authoritative server-only admin allowlist. Empty means no administrators.
# PATCHUP_ADMIN_EMAILS=""
PORT=3000
PATCHUP_SUBMISSION_USER_DAILY_LIMIT=25
# Fixed reporting mailbox; server-only. No Gmail delivery is enabled by this feature.
PATCHUP_REPORT_FROM_EMAIL=""

# Privacy/storage upgrade. Paid mode is an operator attestation, not automatic billing verification.
PATCHUP_GEMINI_DATA_MODE=""
PATCHUP_AI_MONTHLY_LIMIT=3000
PATCHUP_MEDIA_STORAGE=firestore
PATCHUP_MEDIA_BUCKET=""
PATCHUP_UPLOAD_USER_DAILY_LIMIT=10
PATCHUP_UPLOAD_DAILY_LIMIT=100
PATCHUP_UPLOAD_MONTHLY_LIMIT=1000
# Blank uses 250 MB for Firestore or 3 GB for GCS; cumulative allocation, not total usage.
PATCHUP_MEDIA_MAX_NEW_BYTES=""
PATCHUP_MEDIA_MAINTENANCE_ENABLED=false
# Enable only after independently verifying city data use rights and endpoint.
PATCHUP_CITY_ROADS_ENABLED=false
# Cloud Run only. Keep both false until billing, IAM, Google usage rights, and quotas are reviewed.
PATCHUP_GOOGLE_GEOCODING_ENABLED=false
PATCHUP_GOOGLE_GEOCODING_STORAGE_APPROVED=false
