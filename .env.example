# APP_URL: Public URL where PatchUp is hosted (automatically injected by AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# Firebase Admin SDK (Optional for local dev; Cloud Run uses Application Default Credentials)
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Google Maps Platform (Required in Phase 2+)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""

# Optional Gemini Image Analysis (Phase 2+)
# GEMINI_API_KEY is injected by AI Studio Secrets panel when enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# Optional comma-separated PatchUp in-app admin bootstrap allowlist
# PATCHUP_ADMIN_EMAILS="devkotaarya@gmail.com,pandeysaksham450@gmail.com,amariyahcg@gmail.com,birukgebru23@gmail.com,carolinesalinas09@gmail.com,melvindacanay05@gmail.com"
