# Local development only. Never commit or package a populated .env.
# Cloud Run uses deploy/cloud-run.service.yaml and Secret Manager, not this file.
# Restricted public browser credentials; supply only these keys as Docker build args.
VITE_FIREBASE_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
# Defaults from firebase-applet-config.json; overrides are for isolated development only.
# VITE_FIREBASE_APP_ID=""
# VITE_FIRESTORE_DATABASE_ID="(default)"
# GOOGLE_MAPS_MAP_ID="" # Optional map ID; defaults to DEMO_MAP_ID.

# Development credentials only. Use isolated ADC or an explicitly authorized test credential.
# PATCHUP_USE_ADC=true
# FIREBASE_SERVICE_ACCOUNT_JSON=""
# Cloud Run rejects exported credentials and emulator overrides; use attached identity.
PORT=3000

# Server-only Gemini key; in Cloud Run use patchup-gemini-api-key from Secret Manager.
# Do not expose this key as VITE_* or pass it to Docker. Local live CLI requires paid mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
PATCHUP_GEMINI_DATA_MODE=""
# Disabled AI/paid mode blocks new Capture submissions, including manual review.
PATCHUP_IMAGE_AI_ENABLED=false
PATCHUP_AUTO_ACCEPT=false
PATCHUP_BENCHMARK_APPROVED_VERSION=""
# Fixed provider ceilings; lower values allowed, 0 disables calls. UTC windows.
PATCHUP_AI_DAILY_LIMIT=100
PATCHUP_AI_MONTHLY_LIMIT=3000
PATCHUP_AI_MINUTE_LIMIT=10
PATCHUP_AI_USER_DAILY_LIMIT=25
PATCHUP_AI_USER_MINUTE_LIMIT=3

# Server-only allowlist; omitted denies access, explicitly empty reconciles existing admins.
# PATCHUP_ADMIN_EMAILS=""
# Shared report mailbox; drafts only, no automatic email delivery.
PATCHUP_REPORT_FROM_EMAIL=""
PATCHUP_SUBMISSION_USER_DAILY_LIMIT=25

# Firestore default; only set GCS bucket for approved private storage/migration.
PATCHUP_MEDIA_STORAGE=firestore
PATCHUP_MEDIA_BUCKET=""
PATCHUP_MEDIA_MAX_NEW_BYTES=250000000
PATCHUP_MEDIA_MAINTENANCE_ENABLED=false
PATCHUP_UPLOAD_USER_DAILY_LIMIT=10
PATCHUP_UPLOAD_DAILY_LIMIT=100
PATCHUP_UPLOAD_MONTHLY_LIMIT=1000

# Optional local data path; Docker sets /app/data/tiger-roads.json and verifies it.
PATCHUP_TIGER_ROADS_FILE=""
PATCHUP_CITY_ROADS_ENABLED=false
PATCHUP_CITY_ROADS_REUSE_APPROVED=false
# Google preview uses Cloud Run service account OAuth; no Maps Server key is used.
PATCHUP_GOOGLE_GEOCODING_ENABLED=false
PATCHUP_GOOGLE_GEOCODING_PREVIEW_APPROVED=false
# Never enable without completed historical data remediation.
PATCHUP_LOCATION_HISTORY_AUDITED=false

# DLP redaction is mandatory on Cloud Run, with no activation or bypass flag.
# Real pothole uploads fail closed outside Cloud Run. No DLP API key is required.
